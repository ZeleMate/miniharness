# Copy to .env and fill in. Never commit .env.

OPENROUTER_API_KEY=
# Any tool-calling model from https://openrouter.ai/models
OPENROUTER_MODEL=deepseek/deepseek-chat

# Anthropic provider. Prefer `ant auth login` (no key needed). Only uncomment
# this to use an API key: a set key overrides the ant profile, and the `ant` CLI
# counts even an empty value as set (the Python SDK treats an empty one as unset).
# ANTHROPIC_API_KEY=
# claude-haiku-5-5 is the cheap option; claude-opus-5-5 is the most capable Opus
ANTHROPIC_MODEL=claude-opus-5-5
